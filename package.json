{
  "name": "pomodoro-app",
  "version": "1.0.0",
  "description": "番茄钟桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.pomodoro.app",
    "productName": "Pomodoro Timer",
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
